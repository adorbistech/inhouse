# INHOUSE deployment environment (Block 03)
# Copy to .env and adjust locally. Never commit .env — it is git-ignored.

# Host port the INHOUSE frontend container binds to (127.0.0.1 only).
# Chosen after read-only port discovery on the VPS; change only if this
# port is later found to conflict with another service.
INHOUSE_FRONTEND_PORT=8091

# --- Inhouse API (Block 04) ---
# Host port the INHOUSE API container binds to (127.0.0.1 only), and the
# port the API listens on inside its own container. Chosen after read-only
# port discovery on the VPS.
INHOUSE_API_PORT=8092

# Deployment stage identifier for the API's own config validation:
# development | test | staging | production
INHOUSE_API_ENV=production

# Fastify/pino log level: fatal | error | warn | info | debug | trace | silent
INHOUSE_API_LOG_LEVEL=info

# Comma-separated CORS allowlist for the future Inhouse frontend origin(s).
# Left empty by default — no cross-origin access until an origin is
# explicitly configured here. Do not set to "*".
INHOUSE_API_CORS_ORIGINS=

# --- Inhouse Postgres (Block 05) ---
# Dedicated, isolated Inhouse database — never the host's PostgreSQL or any
# other existing service. No host port is published; the API reaches it
# over the inhouse-net Docker network by service name. See docs/DATABASE.md.
INHOUSE_DB_HOST=inhouse-postgres
INHOUSE_DB_PORT=5432
INHOUSE_DB_NAME=inhouse
INHOUSE_DB_USER=inhouse_app

# No default is provided intentionally — set a real value in your local
# .env only. Never commit a real password here or anywhere else.
INHOUSE_DB_PASSWORD=

# Dedicated schema/namespace within the Inhouse database.
INHOUSE_DB_SCHEMA=inhouse

INHOUSE_DB_POOL_MIN=2
INHOUSE_DB_POOL_MAX=10

# Whether to require TLS when connecting to Postgres.
INHOUSE_DB_SSL=false

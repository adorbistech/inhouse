{
  "name": "inhouse-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "test:db:start": "tsx scripts/testDb.ts start",
    "test:db:stop": "tsx scripts/testDb.ts stop",
    "test:db": "npm run test:db:start && node --import tsx --test --test-concurrency=1 test/db/*.test.ts; npm run test:db:stop"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
